# ==============================================================================
# Open Gororoba: Standardized Git Exclusion Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / OS / Editor Noise
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.cargo/*
!.cargo/config.toml
.config/**
!.config/nextest.toml
.claude/
.gemini/
.gororoba_lit_cache/
.playwright-mcp/
.horusec/
.codex
*.pdf

# ------------------------------------------------------------------------------
# 2. Languages & Build Systems
# ------------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
*.egg-info/
src/*.egg-info/
venv/
.venv/
.venv_ingest/
.mamba/

# Rust
# Workspace-local Cargo artifact trees stay untracked under `.cache/` and
# `target/`. The heavy intermediate build state now lives outside the repo
# under `/tmp/open_gororoba-cargo-build/...`, so there is nothing additional
# to ignore here for that split-cache layout.
target/
target_codex_hve/
target_codex_hve2/
.cache/
rustc-ice-*.txt

# Coq / Rocq
curated/01_theory_frameworks/*.vo
curated/01_theory_frameworks/*.vos
curated/01_theory_frameworks/*.vok
curated/01_theory_frameworks/*.glob
proofs/**/*.vo
proofs/**/*.vos
proofs/**/*.vok
proofs/**/*.glob
proofs/**/*.aux
proofs/Makefile.coq
proofs/Makefile.coq.conf
proofs/.Makefile.coq.d
*.lia.cache
*.nra.cache
*.nia.cache

# ------------------------------------------------------------------------------
# 3. Project Artifact Infrastructure (Standardized)
# ------------------------------------------------------------------------------

# Dedicated artifact & log directories
build/
dist/
dist_py/
logs/
reports/benchmark_*.txt
reports/*.csv
reports/*.txt
reports/*.json
# Validation reports are CI/worktree artifacts. Durable findings and measured
# baselines belong in governed docs/engineering records.
reports/validation/

# Chromium and Edge profile state left behind by the acquisition sessions:
# LevelDB index shards, LOCK and LOG files, adblock blocklists, and vendored
# extension payloads. It carries no research content -- the only two files the
# markdown inventory ever picked up were vendor `Edge Wallet` READMEs -- and it
# is byte-churn that a browser rewrites on every launch.
reports/browser_profiles/

# LaTeX build outputs
docs/latex/out/

# Temporary / Scratch space
temp/
tmp/
*.tmp
*.temp
temp.*

# ------------------------------------------------------------------------------
# 4. Data & External Resources (Managed via Makefile)
# ------------------------------------------------------------------------------

# Simulation Outputs (Regenerable via binary re-execution)
data/h5/
data/artifacts/images/
data/artifacts/*.mp4
data/artifacts/*.png
data/artifacts/c756_frames/
data/artifacts/*.json
data/artifacts/*.txt
!data/artifacts/PROVENANCE.local.json
data/output/**/*.json
data/output/**/*.jsonl
data/output/**/*.csv
data/output/**/*.md
data/output/**/*.npy
data/output/**/*.npz
data/output/**/*.pkl
data/output/*.png
!data/output/audit/**
# Audit captures cite third-party documents by digest and never hold their bytes.
data/output/audit/**/*.pdf
data/output/audit/**/*.pdf.gz
# Multi-megabyte regenerable snapshots stay out of the tracked audit bundles;
# `cargo metadata` reproduces them from the lockfile at any commit.
data/output/audit/**/*cargo-metadata*.json
data/artifacts/frames_*/
data/e027/
data/test-e027/
# data/csv holds tracked first-party tables; new outputs written there stay local
# until added with git add -f.
data/csv/

# Rendered figures beside the tracked data/results tables stay local.
data/results/e183/*.pdf
data/test_zd/
data/test_zd_1k/
data/chsh_betti/
data/chsh_wavelet/
data/entropy_census/
data/fano_scattering/
data/lattice_hawking/
data/meltdown_pulsed/
data/meltdown_gating/
data/apt-test/
data/wavelet_bridging/
data/wavelet_acf/
data/thesis_lab/
data/thesis_lab_kolmogorov/
data/thesis_lab_non_newtonian/
data/kubo_transport/
data/equivalence/
data/papers/
data/evidence/**
!data/evidence/
!data/evidence/MANIFEST.toml
data/sfwm_repro/
data/bl_6equj5_ata/
data/bl_6equj5_gbt/
data/benchmarks/

# External / Downloaded Datasets (Managed via fetch-data)
data/external/**
!data/external/
!data/external/README.md
!data/external/PROVENANCE.local.json
!data/external/SOURCES.toml
!data/external/flyby_anomaly/
!data/external/flyby_anomaly/anderson_2008_flyby_catalog.csv
!data/external/pioneer_anomaly/
!data/external/pioneer_anomaly/pioneer_anomaly_benchmark.csv
!data/external/crossing_lists/
!data/external/crossing_lists/**

# Archived non-replayable payloads (track only retirement manifests)
archive/external_legacy_placeholders/**
!archive/external_legacy_placeholders/
!archive/external_legacy_placeholders/RETIREMENT_MANIFEST.toml
archive/external_nonreproducible_snapshots/**
!archive/external_nonreproducible_snapshots/
!archive/external_nonreproducible_snapshots/RETIREMENT_MANIFEST.toml

# Workspace-local SQLite databases and ad hoc DB files stay untracked.
# Checked-in canonical databases under registry/canonical are tracked explicitly.
*.db
.gororoba.db
*.sqlite3
!registry/canonical/
!registry/canonical/*.sqlite3
# Pre-import snapshots and semantic diffs written by
# provenance index-control-plane --allow-destructive-reimport. They record what
# a destructive re-import would overwrite; the canonical database carries the
# durable state.
registry/canonical/backups/
# SQLite WAL-mode companion files. Created when a connection is open;
# normally cleaned up at last-disconnect, but a crash or hung process can
# leave them behind. They are machine-local; the owning database file carries
# the durable state.
*.sqlite3-wal
*.sqlite3-shm

# ------------------------------------------------------------------------------
# 5. Secrets & Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
*.env
*.pem
*.key
credentials.*

# ------------------------------------------------------------------------------
# 6. Documentation & Registry Governance
# ------------------------------------------------------------------------------

# Strict TOML-only policy: markdown files are generated/ephemeral and not tracked.
# EXCEPTIONS:
#   - mandatory repo entrypoints and authoritative syntheses
#   - curated top-level docs/reports markdown that is explicitly governed by
#     registry/markdown_owner_map.toml and the markdown inventory gate
# This keeps opportunistic LLM-spam markdown out of the repo while permitting
# real report artifacts that have ownership and removal policy.
*.md
!docs/THEOREMS.md
!docs/REQUIREMENTS.md
!docs/requirements/
!docs/requirements/*.md
!docs/generated/THEOREMS_REGISTRY_MIRROR.md
!docs/book/src/proofs/index.md
![Aa][Gg][Ee][Nn][Tt][Ss].md
![Cc][Ll][Aa][Uu][Dd][Ee].md
![Gg][Ee][Mm][Ii][Nn][Ii].md
![Rr][Ee][Aa][Dd][Mm][Ee].md
!README_GPU_STEPS.md
!**/[Rr][Ee][Aa][Dd][Mm][Ee].md
!data/output/audit/staples-causal-validation/completion-audit.md
!data/output/audit/staples-causal-validation/source-archives/license-evidence.md
!proofs/EPISTEMIC_BOUNDARIES.md
!docs/toolchain/
!docs/toolchain/*.md
!docs/adr/
!docs/adr/*.md
!docs/research/high_dimensional_algebra_unification_2026.md
!docs/research/nanograv_15yr_cayley_dickson_synthesis_2026.md
!docs/external_sources/*.md
!docs/tickets/TICKET_PIONEER_FLYBY_FRACTAL_BRIDGE.md
!docs/GRAND_SYNTHESIS.md
!docs/NAVIGATOR.md
!docs/EXCEPTIONAL_COSMOLOGY.md
!docs/SEDENION_GRAVASTAR_EQUIVALENCE.md
!docs/GRAND_SYNTHESIS_PLAN.md
!docs/db/ARCHITECTURE.md
!docs/physics/sedenion_standard_model.md
!docs/reports/RC1_EVIDENCE_NOTE.md
!docs/ablation_preregistration.md
!docs/reports/POST_RC1_32D_EVIDENCE_NOTE.md
!docs/reports/*_commit_audit_*.md
!docs/reports/*_roadmap_*.md
!docs/monograph/MERGED_MONOGRAPH.md
!docs/reports/root_promoted/*.md
!docs/reports/enso_91103_outlook_*.md
# Stage B documentation lanes (glossary, cache policy, experiment manifest, upgrade history).
!docs/engineering/
!docs/engineering/*.md
!docs/dependencies/
!docs/dependencies/*.md
!docs/glossary.md
!vendor/proc-macro-error2/CHANGELOG.md
!vendor/zarrs-0.23.14/VENDORED.md
!vendor/zarrs-0.23.14/doc/**/*.md

# ------------------------------------------------------------------------------
# 7. Root Directory Protection (Keep Root Clean)
# ------------------------------------------------------------------------------
# Ignore ad-hoc logs, scripts, and results in root to force migration to standardized paths.
# The root-level src/ directory holds Python analysis code (ghost_stats, gemini_physics,
# spectral, holography, quantum, verification, scripts). These files are not committed to
# git -- all analysis migrated to Rust crates. This entry prevents false-positive
# evidence-link failures in claims-verify for claims referencing old Python script paths.
# Leading slash anchors this to the repo root only -- crates/*/src/ are unaffected.
/src/
/*.log
/*.sh
/*.tex
/*.bib
/*.data
/*.data.old
/*.png
/*.jpg
/*.ptx
/*.txt
*.h5
.venv/
h_trace_*.csv

# CertiRocq (rocq-certirocq) verified Gallina->C extraction output
proofs/OpenGororoba.*.c
proofs/OpenGororoba.*.h
proofs/extraction/OpenGororoba.*.c
proofs/extraction/OpenGororoba.*.h
proofs/extraction/glue.*
proofs/extraction/r2vb_dp4_glue.c
proofs/extraction/r2vb_dp4_glue.h
proofs/extraction/test_r2vb_dp4
proofs/extraction/test_r2vb_dp4_admit

# Per-host artifact materialization manifests: host state, never repository truth.
data/output/external_manifests/
!docs/research/crossing-detector-statistical-benefit.md

