Complex.carrier
     : Type
Complex.cd_mul
     : Complex.carrier -> Complex.carrier -> Complex.carrier
Complex.mul_scale_left
     : forall (r : R) (x y : Complex.carrier),
       Complex.cd_mul (Complex.cd_scale r x) y =
       Complex.cd_scale r (Complex.cd_mul x y)
Complex.mul_scale_right
     : forall (r : R) (x y : Complex.carrier),
       Complex.cd_mul x (Complex.cd_scale r y) =
       Complex.cd_scale r (Complex.cd_mul x y)
Complex.conj_scale
     : forall (r : R) (x : Complex.carrier),
       Complex.cd_conj (Complex.cd_scale r x) =
       Complex.cd_scale r (Complex.cd_conj x)
Complex.neg_scale
     : forall (r : R) (x : Complex.carrier),
       Complex.cd_neg (Complex.cd_scale r x) =
       Complex.cd_scale r (Complex.cd_neg x)
Complex.scale_add
     : forall (r : R) (x y : Complex.carrier),
       Complex.cd_scale r (Complex.cd_add x y) =
       Complex.cd_add (Complex.cd_scale r x) (Complex.cd_scale r y)
Complex.scale_sub
     : forall (r : R) (x y : Complex.carrier),
       Complex.cd_scale r (Complex.cd_sub x y) =
       Complex.cd_sub (Complex.cd_scale r x) (Complex.cd_scale r y)
Complex.sub_def
     : forall x y : Complex.carrier,
       Complex.cd_sub x y = Complex.cd_add x (Complex.cd_neg y)
